{
  "manifest_version": 3,
  "name": "WebLab - Courses Currently Taking",
  "version": "1.0.0",
  "description": "Adds a clean, dedicated Courses Currently Taking section to the top of TU Delft WebLab.",
  "author": "David Ignat",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weblab.tudelft.nl/*",
        "https://weblab.ewi.tudelft.nl/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "WebLab Enhancer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}
